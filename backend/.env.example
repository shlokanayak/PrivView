# Copy this file to ".env" and fill in your own values.
# NEVER upload the real .env to GitHub.

# Used by Flask to sign the login session cookie (make it long and random)
SECRET_KEY=put-a-long-random-string-here

# PostgreSQL connection (user, password, database from the setup step)
DATABASE_URL=postgresql+psycopg://privview_user:YourDbPassword@localhost:5432/privview

# Gmail account that SENDS the OTP emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.sender@gmail.com
SMTP_APP_PASSWORD=abcdefghijklmnop

# Stage 2: AES-256 key that encrypts every stored dataset (32 random bytes, base64).
# Create it ONCE with:
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# If you lose or change this key, already-stored datasets can no longer be decrypted!
DATA_ENCRYPTION_KEY=paste-the-generated-key-here
